# Variables de entorno para Railway / producción
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Mercado Pago
PAYMENT_PROVIDER=mercadopago
PAYMENT_ACCESS_TOKEN=APP_USR-...
# URL publica del deploy: Mercado Pago vuelve del checkout y manda webhooks aca
PAYMENT_BASE_URL=https://tu-app.up.railway.app
# Opcional: clave secreta de webhook (panel de developers de MP).
# Si se configura, el webhook valida la firma x-signature y rechaza las demas.
PAYMENT_WEBHOOK_SECRET=

# Admin (cambiar en producción)
ADMIN_NAME=Administración
ADMIN_EMAIL=admin@kiosco.local
ADMIN_PASSWORD=Admin1234